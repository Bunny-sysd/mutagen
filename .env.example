# Mutagen Configuration Template
# Copy this file to '.env' and fill in your values.
# All MUTAGEN_* variables are optional — sensible defaults are built in.

# ── API Keys ────────────────────────────────────────────────────────────────

# Gemini API Key (Required for default gemini provider)
GEMINI_API_KEY=your_key_here

# OpenAI API Key (Required if using --provider openai)
OPENAI_API_KEY=your_key_here

# Claude API Key (Required if using --provider claude)
ANTHROPIC_API_KEY=your_key_here

# Webhook signing secret (required when --webhook-url is set)
# MUTAGEN_WEBHOOK_SECRET=your_hmac_secret_here

# ── LLM Provider & Model ────────────────────────────────────────────────────

# Default AI provider. Choices: gemini | openai | claude | ollama
MUTAGEN_PROVIDER=gemini

# Default model name for the selected provider
MUTAGEN_MODEL=gemini-2.5-flash

# ── Execution & Fuzzing Tuning ───────────────────────────────────────────────

# Per-payload subprocess execution timeout in seconds (default: 5)
# MUTAGEN_EXEC_TIMEOUT=5

# Maximum number of self-healing patch-then-verify attempts (default: 3)
# MUTAGEN_MAX_PATCH_RETRIES=3

# ── Docker Sandbox Resource Limits ──────────────────────────────────────────

# Memory cap for the Docker sandbox container (default: 512m)
# MUTAGEN_DOCKER_MEMORY=512m

# CPU quota for the Docker sandbox container (default: 1.0)
# MUTAGEN_DOCKER_CPUS=1.0

# Docker image to use when --sandbox docker is active (default: ubuntu:latest)
# MUTAGEN_SANDBOX_IMAGE=ubuntu:latest

# ── Gemini API / HTTP Transport ──────────────────────────────────────────────

# Total HTTP request timeout for Gemini API calls in seconds (default: 15.0)
# MUTAGEN_GEMINI_HTTP_TIMEOUT=15.0

# TCP connect timeout for Gemini API calls in seconds (default: 5.0)
# MUTAGEN_GEMINI_CONNECT_TIMEOUT=5.0

# Read timeout for Gemini API calls in seconds (default: 10.0)
# MUTAGEN_GEMINI_READ_TIMEOUT=10.0

# Write timeout for Gemini API calls in seconds (default: 10.0)
# MUTAGEN_GEMINI_WRITE_TIMEOUT=10.0

# Seconds to wait when a 429 rate-limit is hit (default: 20)
# MUTAGEN_RATE_LIMIT_WAIT=20

# ── LLM Sampling Parameters ─────────────────────────────────────────────────

# Sampling temperature for the TriageAgent (lower = more deterministic, default: 0.1)
# MUTAGEN_TRIAGE_TEMPERATURE=0.1

# Sampling temperature for the PayloadSynthesizerAgent (higher = more creative, default: 0.5)
# MUTAGEN_SYNTHESIZER_TEMPERATURE=0.5

# ── Compiler Discovery (Windows) ─────────────────────────────────────────────

# Explicit path to a GCC-compatible binary. If set, probed first.
# MUTAGEN_GCC_PATH=C:\msys64\ucrt64\bin\gcc.exe

# ── Dashboard & Security ─────────────────────────────────────────────────────
# MUTAGEN_JWT_SECRET=specify_a_secure_jwt_signing_key_here
# MUTAGEN_ENV=development
